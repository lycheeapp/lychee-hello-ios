// Lychee Hello — Release (production environment).
//
// ⚠️ The production signing private key is NOT in this file and must never be committed.
// It goes in the gitignored Config/Secrets.xcconfig, included at the end of this file
// (scripts/make-secrets-xcconfig.sh writes it; see README, "Request signing").
// LYCHEE_SIGNING_KEY_ID below must match the key_id of the PUBLIC key registered in
// signing_client_key for client `hello-ios`.

SLASH = /

API_BASE_URL = https:$(SLASH)$(SLASH)apiproduction.lycheeapp.org/rest/lychee-v2
API_HELLO_PATH = /hello/v1

LYCHEE_SIGNING_CLIENT_ID = hello-ios
// Placeholder — Config/Secrets.xcconfig, included at the end of this file, sets the real key id.
// Left non-empty so a build without it fails loudly at startup rather than silently sending
// unsigned requests.
LYCHEE_SIGNING_KEY_ID = REPLACE_AT_BUILD_TIME

LYCHEE_ENVIRONMENT_NAME = prod

LYCHEE_LOG_NETWORK = NO

// The production signing key and its key id, from the gitignored Config/Secrets.xcconfig
// (scripts/make-secrets-xcconfig.sh). Last, so its LYCHEE_SIGNING_KEY_ID overrides the placeholder
// above. Optional (#include?) so the project opens without it; the "Check release signing key"
// build phase stops a Release build that lacks it.
#include? "Secrets.xcconfig"
